{UTF-8}
Offene Bestellungen= INTEG (
	angenommene Bestellungen-Zubereitung gestartet,
		0)
	~	Bestellungen
	~	STOCK (Warteschlange). Angenommene Bestellungen, mit deren Zubereitung noch \
		niemand begonnen hat.
	|

Bestellungen in Zubereitung= INTEG (
	Zubereitung gestartet-fertige Bestellungen,
		0)
	~	Bestellungen
	~	STOCK. Belegt oder im Ofen. Materielle Verzögerung: Abfluss = Bestand / Backzeit.
	|

Verlorene Bestellungen= INTEG (
	abgelehnte Bestellungen,
		0)
	~	Bestellungen
	~	STOCK. Kumuliert abgelehnte Nachfrage des Abends.
	|

angenommene Bestellungen=
	Nachfrage-abgelehnte Bestellungen
	~	Bestellungen/Stunde
	~	INFLOW.
	|

abgelehnte Bestellungen=
	Nachfrage*Ablehnungsanteil
	~	Bestellungen/Stunde
	~	FLOW in Verlorene Bestellungen.
	|

Ablehnungsanteil=
	MIN(1, MAX(0, (wahrgenommene Durchlaufzeit-Schwelle Durchlaufzeit)/Toleranzband))
	~	Dmnl
	~	ENTSCHEIDUNGSREGEL des Küchenchefs, in Minuten statt Auslastung. Default = \
		exakte Übersetzung der Teamregel 1.5 / 2.5 aus v3 (22.5 bis 37.5 Minuten).
	|

Schwelle Durchlaufzeit=
	22.5
	~	Minuten
	~	HEBELPUNKT. Ab dieser wahrgenommenen Durchlaufzeit beginnt die Ablehnung. \
		Aus Teamregel 1.5 abgeleitet. OFFEN: Lieferzusage erfragen.
	|

Toleranzband=
	15
	~	Minuten
	~	Spanne von erster bis vollständiger Ablehnung. Aus Teamregel 2.5 abgeleitet.
	|

Zubereitung gestartet=
	MIN(Offene Bestellungen/Vorbereitungszeit, MIN(Personalkapazität, fertige Bestellungen+freie Ofenplätze/Vorbereitungszeit))
	~	Bestellungen/Stunde
	~	FLOW. Begrenzt durch Personal (Engpass 1) und freie Ofenplätze (Engpass 2).
	|

fertige Bestellungen=
	Bestellungen in Zubereitung/Backzeit
	~	Bestellungen/Stunde
	~	OUTFLOW. Materielle Verzögerung 1. Ordnung mit der Backzeit.
	|

Vorbereitungszeit=
	1/Leistung pro Person
	~	Stunde
	~	VERZÖGERUNG. Abgeleitet: 12 Bestellungen pro Person und Stunde = 5 Minuten.
	|

Personalkapazität=
	Personal im Einsatz*Leistung pro Person
	~	Bestellungen/Stunde
	~	Kapazität des Engpasses Personal.
	|

freie Ofenplätze=
	MAX(0, Ofenplätze-Bestellungen in Zubereitung)
	~	Bestellungen
	~	Freie Plätze im Ofen.
	|

Ofenkapazität=
	Ofenplätze/Backzeit
	~	Bestellungen/Stunde
	~	Durchsatz des Ofens.
	|

Kapazität der Küche=
	MIN(Ofenkapazität, Personalkapazität)
	~	Bestellungen/Stunde
	~	Engpass = der kleinere Wert.
	|

Auslastung Personal=
	ZIDZ(Zubereitung gestartet, Personalkapazität)
	~	Dmnl
	~	KPI 0..1. Echte Auslastung des Personals.
	|

Auslastung Ofen=
	ZIDZ(Bestellungen in Zubereitung, Ofenplätze)
	~	Dmnl
	~	KPI 0..1. Belegung des Ofens.
	|

Erwartete Durchlaufzeit=
	(Wartezeit in Schlange+Vorbereitungszeit+Backzeit)*Minuten je Stunde
	~	Minuten
	~	KPI. Little's Law: Wartezeit in der Schlange plus Zubereitung plus Backen.
	|

Wartezeit in Schlange=
	IF THEN ELSE(Offene Bestellungen<0.001, 0, XIDZ(Offene Bestellungen, Zubereitung gestartet, 99))
	~	Stunde
	~	Little's Law. 99 Stunden, wenn nichts mehr gestartet wird (z.B. kein Personal).
	|

wahrgenommene Durchlaufzeit=
	SMOOTH(Erwartete Durchlaufzeit, Wahrnehmungsverzögerung)
	~	Minuten
	~	INFORMATIONSVERZÖGERUNG. Der Küchenchef sieht den Stau erst verzögert.
	|

Wahrnehmungsverzögerung=
	0.015625
	~	Stunde
	~	OFFEN. Default = 1 Zeitschritt (praktisch sofort, wie Modell v3). In der \
		Sensitivität 5 bis 30 Minuten getestet.
	|

Minuten je Stunde=
	60
	~	Minuten/Stunde
	~	|

Backzeit=
	0.25
	~	Stunde
	~	VERZÖGERUNG. Teamwert v3. OFFEN: reine Ofenzeit oder ganze Durchlaufzeit?
	|

Leistung pro Person=
	12
	~	Bestellungen/(Stunde*Personen)
	~	Teamwert v3. OFFEN: aus Kassendaten messen.
	|

Ofenplätze=
	10
	~	Bestellungen
	~	Abgeleitet aus Teamwerten: 40 pro Stunde x 0.25 Stunden. OFFEN: echte Anzahl.
	|

Personal im Einsatz=
	3
	~	Personen
	~	Teamwert v3, aus dem Wochenend-Einsatzplan.
	|

Nachfrage=
	Nachfrage Basis+STEP(Nachfrage Stosszeit-Nachfrage Basis, 1)-STEP(Nachfrage Stosszeit-Nachfrage Basis, 4)
	~	Bestellungen/Stunde
	~	EXTERN.
	|

Nachfrage Basis=
	30
	~	Bestellungen/Stunde
	~	Teamwert v3. OFFEN: Kassendaten.
	|

Nachfrage Stosszeit=
	60
	~	Bestellungen/Stunde
	~	Teamwert v3. OFFEN: Kassendaten. Widerspricht 400/Woche im Charter.
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 6
	~	Stunde
	~	17 bis 23 Uhr.
	|

INITIAL TIME  = 0
	~	Stunde
	~	|

SAVEPER  = 
        TIME STEP
	~	Stunde [0,?]
	~	|

TIME STEP  = 0.015625
	~	Stunde [0,?]
	~	Kleiner als ein Fünftel der kürzesten Verzögerung (5 Minuten).
	|

