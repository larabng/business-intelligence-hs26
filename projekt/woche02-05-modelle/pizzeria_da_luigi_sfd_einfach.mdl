{UTF-8}
Offene Bestellungen= INTEG (
	angenommene Bestellungen-Zubereitung gestartet,
		0)
	~	Bestellungen
	~	BESTAND (Warteschlange). Angenommene Bestellungen, mit deren Zubereitung \
		noch niemand begonnen hat.
	|

Bestellungen in Zubereitung= INTEG (
	Zubereitung gestartet-fertige Bestellungen,
		0)
	~	Bestellungen
	~	BESTAND. Bestellungen im Ofen.
	|

Verlorene Bestellungen= INTEG (
	abgelehnte Bestellungen,
		0)
	~	Bestellungen
	~	BESTAND. Alle abgelehnten Bestellungen des Abends.
	|

angenommene Bestellungen=
	Nachfrage-abgelehnte Bestellungen
	~	Bestellungen/Stunde
	~	ZUFLUSS in die Schlange.
	|

abgelehnte Bestellungen=
	Nachfrage*Ablehnungsanteil
	~	Bestellungen/Stunde
	~	FLUSS in Verlorene Bestellungen.
	|

Zubereitung gestartet=
	MIN(Offene Bestellungen*Leistung pro Person, Personalkapazität)
	~	Bestellungen/Stunde
	~	FLUSS. Vorbereitung dauert 1/Leistung = 5 Min.; begrenzt durch das \
		Personal (Engpass). Der Ofen (40/Std.) ist bei 28/Std. nie Engpass und \
		wird deshalb nicht modelliert.
	|

fertige Bestellungen=
	Bestellungen in Zubereitung/Backzeit
	~	Bestellungen/Stunde
	~	ABFLUSS nach der Backzeit.
	|

Ablehnungsanteil=
	MIN(1, MAX(0, (Erwartete Durchlaufzeit-Schwelle Durchlaufzeit)/15))
	~	Dmnl
	~	ENTSCHEIDUNGSREGEL des Kuechenchefs (Actionable Signal): ab der Schwelle \
		beginnt die Ablehnung, 15 Min. spaeter wird alles abgelehnt.
	|

Schwelle Durchlaufzeit=
	22.5
	~	Minuten
	~	HEBEL. Lieferzusage 45 Min. minus 10 Min. Lieferweg = 35 Min. fuer die \
		Kueche. Ohne Stau dauert eine Bestellung 20 Min.
	|

Erwartete Durchlaufzeit=
	(IF THEN ELSE(Offene Bestellungen<0.001, 0, XIDZ(Offene Bestellungen, Zubereitung gestartet, 99))+Backzeit)*60
	~	Minuten
	~	Little's Law: Zeit in der Schlange (inkl. 5 Min. Vorbereitung) plus Backzeit, \
		in Minuten.
	|

Backzeit=
	0.25
	~	Stunde
	~	15 Minuten im Ofen.
	|

Leistung pro Person=
	12
	~	Bestellungen/(Stunde*Personen)
	~	ANNAHME. OFFEN: mit Kassendaten pruefen.
	|

Personalkapazität=
	Personal im Einsatz*Leistung pro Person
	~	Bestellungen/Stunde
	~	Wie viele Bestellungen die Kueche pro Stunde starten kann.
	|

Personal im Einsatz=
	2+Feedforward Schalter*IF THEN ELSE(Erwartete Nachfrage Prognose>2*Leistung pro Person, 1, 0)
	~	Personen
	~	2 Personen in der Kueche (Charter). FEEDFORWARD: Liegt die Prognose ueber \
		der Kapazitaet von 2 Personen, wird vorab eine Aushilfe eingeplant.
	|

Feedforward Schalter=
	0
	~	Dmnl [0,1,1]
	~	0 = heute, 1 = Einsatzplan nach Prognose.
	|

Erwartete Nachfrage Prognose=
	Nachfrage Stosszeit
	~	Bestellungen/Stunde
	~	Vorab bekannt aus Wetter, Anlaessen, Reservationen, Plattform-Aktionen \
		(Stoergroessen S1-S3).
	|

Nachfrage=
	9+STEP(Nachfrage Stosszeit-9, 1)-STEP(Nachfrage Stosszeit-9, 4)
	~	Bestellungen/Stunde
	~	EXTERN. 9 pro Stunde, von 18 bis 21 Uhr Stosszeit.
	|

Nachfrage Stosszeit=
	28
	~	Bestellungen/Stunde
	~	Spitze 18-21 Uhr. 9 + 3x28 + 2x9 = 111 Bestellungen pro Abend.
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 6
	~	Stunde
	~	17 bis 23 Uhr.
	|

INITIAL TIME  = 0
	~	Stunde
	~	|

SAVEPER  = 
        TIME STEP
	~	Stunde [0,?]
	~	|

TIME STEP  = 0.015625
	~	Stunde [0,?]
	~	Kleiner als ein Fünftel der kürzesten Verzögerung (5 Minuten).
	|

