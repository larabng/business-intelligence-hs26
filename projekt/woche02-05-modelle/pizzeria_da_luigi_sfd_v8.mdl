{UTF-8}
Offene Bestellungen= INTEG (
	angenommene Bestellungen-Zubereitung gestartet,
		0)
	~	Bestellungen
	~	STOCK (Warteschlange). Angenommene Bestellungen, mit deren Zubereitung noch \
		niemand begonnen hat.
	|

Bestellungen in Zubereitung= INTEG (
	Zubereitung gestartet-fertige Bestellungen,
		0)
	~	Bestellungen
	~	STOCK. Belegt oder im Ofen. Materielle Verzögerung: Abfluss = Bestand / Backzeit.
	|

Verlorene Bestellungen= INTEG (
	abgelehnte Bestellungen,
		0)
	~	Bestellungen
	~	STOCK. Kumuliert abgelehnte Nachfrage des Abends.
	|

angenommene Bestellungen=
	Nachfrage-abgelehnte Bestellungen
	~	Bestellungen/Stunde
	~	INFLOW.
	|

abgelehnte Bestellungen=
	Nachfrage*Ablehnungsanteil
	~	Bestellungen/Stunde
	~	FLOW in Verlorene Bestellungen.
	|

Ablehnungsanteil=
	MIN(1, MAX(0, (wahrgenommene Durchlaufzeit-Schwelle Durchlaufzeit)/Toleranzband))
	~	Dmnl
	~	ENTSCHEIDUNGSREGEL des Küchenchefs, in Minuten statt Auslastung. Default = \
		exakte Übersetzung der Teamregel 1.5 / 2.5 aus v3 (22.5 bis 37.5 Minuten).
	|

Schwelle Durchlaufzeit=
	22.5
	~	Minuten
	~	HEBELPUNKT. Ab dieser wahrgenommenen Durchlaufzeit beginnt die Ablehnung. \
		Lieferzusage 45 Min. (Charter v1) minus ca. 10 Min. Lieferweg = 35 Min. \
		Kuechenbudget. Ohne Stau dauert eine Bestellung 20 Min.; ab 22.5 Min. \
		bildet sich eine Schlange, ab 37.5 Min. ist die Zusage nicht haltbar.
	|

Toleranzband=
	15
	~	Minuten
	~	Spanne von erster bis vollständiger Ablehnung. Aus Teamregel 2.5 abgeleitet.
	|

Zubereitung gestartet=
	MIN(Offene Bestellungen/Vorbereitungszeit, MIN(Personalkapazität, fertige Bestellungen+freie Ofenplätze/Vorbereitungszeit))
	~	Bestellungen/Stunde
	~	FLOW. Begrenzt durch Personal (Engpass 1) und freie Ofenplätze (Engpass 2).
	|

fertige Bestellungen=
	Bestellungen in Zubereitung/Backzeit
	~	Bestellungen/Stunde
	~	OUTFLOW. Materielle Verzögerung 1. Ordnung mit der Backzeit.
	|

Vorbereitungszeit=
	1/Leistung pro Person
	~	Stunde
	~	VERZÖGERUNG. Abgeleitet: 12 Bestellungen pro Person und Stunde = 5 Minuten.
	|

Personalkapazität=
	Personal im Einsatz*Leistung pro Person
	~	Bestellungen/Stunde
	~	Kapazität des Engpasses Personal.
	|

freie Ofenplätze=
	MAX(0, Ofenplätze-Bestellungen in Zubereitung)
	~	Bestellungen
	~	Freie Plätze im Ofen.
	|

Ofenkapazität=
	Ofenplätze/Backzeit
	~	Bestellungen/Stunde
	~	Durchsatz des Ofens.
	|

Kapazität der Küche=
	MIN(Ofenkapazität, Personalkapazität)
	~	Bestellungen/Stunde
	~	Engpass = der kleinere Wert.
	|

Auslastung Personal=
	ZIDZ(Zubereitung gestartet, Personalkapazität)
	~	Dmnl
	~	KPI 0..1. Echte Auslastung des Personals.
	|

Auslastung Ofen=
	ZIDZ(Bestellungen in Zubereitung, Ofenplätze)
	~	Dmnl
	~	KPI 0..1. Belegung des Ofens.
	|

Erwartete Durchlaufzeit=
	(Wartezeit in Schlange+Backzeit)*Minuten je Stunde
	~	Minuten
	~	KPI. Little's Law: Zeit in der Schlange (inkl. Vorbereitung) plus Backen. \
		v8: Vorbereitungszeit nicht mehr separat addiert, weil sie bereits im \
		Abfluss der Schlange steckt (sonst doppelt gezaehlt: 25 statt 20 Minuten).
	|

Wartezeit in Schlange=
	IF THEN ELSE(Offene Bestellungen<0.001, 0, XIDZ(Offene Bestellungen, Zubereitung gestartet, 99))
	~	Stunde
	~	Little's Law: Offene Bestellungen / Zubereitung gestartet. Enthaelt die \
		Vorbereitungszeit (5 Min.) plus echtes Warten. 99 Stunden, wenn nichts \
		mehr gestartet wird (z.B. kein Personal).
	|

wahrgenommene Durchlaufzeit=
	SMOOTH(Erwartete Durchlaufzeit, Wahrnehmungsverzögerung)
	~	Minuten
	~	INFORMATIONSVERZÖGERUNG. Der Küchenchef sieht den Stau erst verzögert.
	|

Wahrnehmungsverzögerung=
	0.015625
	~	Stunde
	~	OFFEN. Default = 1 Zeitschritt (praktisch sofort, wie Modell v3). In der \
		Sensitivität 5 bis 30 Minuten getestet.
	|

Minuten je Stunde=
	60
	~	Minuten/Stunde
	~	|

Backzeit=
	0.25
	~	Stunde
	~	VERZÖGERUNG. Teamwert v3. OFFEN: reine Ofenzeit oder ganze Durchlaufzeit?
	|

Leistung pro Person=
	12
	~	Bestellungen/(Stunde*Personen)
	~	Teamwert v3. OFFEN: aus Kassendaten messen.
	|

Ofenplätze=
	10
	~	Bestellungen
	~	Abgeleitet aus Teamwerten: 40 pro Stunde x 0.25 Stunden. OFFEN: echte Anzahl.
	|

Personal im Einsatz=
	Basispersonal Kueche+Feedforward Schalter*IF THEN ELSE(Erwartete Nachfrage Prognose>Basispersonal Kueche*Leistung pro Person, Zusatzpersonal, 0)
	~	Personen
	~	FEEDFORWARD. Personen in der Kueche. Liegt die Prognose ueber der Kapazitaet \
		des Basispersonals, wird vorab (bis Mittwoch, Antwortkarte 2) eine \
		Aushilfe zusaetzlich eingeplant.
	|

Basispersonal Kueche=
	2
	~	Personen
	~	Aus System Charter v1: abends 2 Personen in der Kueche. Der Service macht \
		keine Pizzen.
	|

Zusatzpersonal=
	1
	~	Personen
	~	Eine zusaetzliche Aushilfe am Wochenende.
	|

Feedforward Schalter=
	0
	~	Dmnl [0,1,1]
	~	0 = heute (keine Vorsteuerung), 1 = Einsatzplan nach Prognose. Wie im \
		Baeckerei-Beispiel fuer den Vergleich mit/ohne Feedforward.
	|

Erwartete Nachfrage Prognose=
	Nachfrage Stosszeit
	~	Bestellungen/Stunde
	~	Prognose der Spitzennachfrage, vorab bekannt aus Wochentag, Wetter, Anlaessen, \
		Gruppenreservationen und Plattform-Aktionen (Stoergroessen S1-S3). \
		Vereinfachung: Prognose = tatsaechliche Spitze (perfekte Prognose).
	|

Nachfrage=
	Nachfrage Basis+STEP(Nachfrage Stosszeit-Nachfrage Basis, 1)-STEP(Nachfrage Stosszeit-Nachfrage Basis, 4)
	~	Bestellungen/Stunde
	~	EXTERN. 17-18 Uhr Basis, 18-21 Uhr Stosszeit, 21-23 Uhr Basis.
	|

Nachfrage Basis=
	9
	~	Bestellungen/Stunde
	~	Aus System Charter v1: ca. 110 Bestellungen pro Fr/Sa-Abend, ausserhalb der \
		Spitze ca. 9 pro Stunde. OFFEN: mit Kassendaten pruefen.
	|

Nachfrage Stosszeit=
	28
	~	Bestellungen/Stunde
	~	Aus System Charter v1: Spitze 18-21 Uhr ca. 28 Bestellungen pro Stunde. \
		9 + 3x28 + 2x9 = 111 pro Abend, passt zu 400 pro Woche.
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 6
	~	Stunde
	~	17 bis 23 Uhr.
	|

INITIAL TIME  = 0
	~	Stunde
	~	|

SAVEPER  = 
        TIME STEP
	~	Stunde [0,?]
	~	|

TIME STEP  = 0.015625
	~	Stunde [0,?]
	~	Kleiner als ein Fünftel der kürzesten Verzögerung (5 Minuten).
	|

